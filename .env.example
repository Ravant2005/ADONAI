# ============================================================================
# ADONAI Production-Grade Pilot Configuration
# Copy this file to .env and insert your API keys and endpoints
# ============================================================================

# --- Stage 1: Blockchain Anchor (Polygon / Arbitrum L2) ---
# Alchemy RPC URL for anchoring SHA-256 root hashes on Polygon (Amoy testnet or Mainnet)
ALCHEMY_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# EVM Signer Private Key (with small amount of MATIC/POL for gas)
GUARDIAN_SIGNER_PRIVATE_KEY=your_ethereum_or_polygon_private_key_here

# --- Stage 2: Web Intelligence & Reverse Search ---
# Google Custom Search JSON API Key & Programmable Search Engine ID (CX)
GOOGLE_SEARCH_API_KEY=AIzaSyYOUR_GOOGLE_SEARCH_API_KEY
GOOGLE_SEARCH_ENGINE_ID=YOUR_PROGRAMMABLE_SEARCH_ENGINE_CX_ID

# NewsAPI.org (Global news publisher feed)
NEWS_API_KEY=your_newsapi_org_api_key

# Microsoft Azure Bing Web Search v7
BING_SEARCH_API_KEY=your_azure_bing_search_v7_key

# --- Stage 3: LLM Threat Explanation & Forensics ---
# Local Ollama endpoint (100% free, local GPU inference, zero data leakage)
ADONAI_LLM_BASE_URL=http://127.0.0.1:11434
ADONAI_LLM_MODEL=llama3.2:3b-instruct-local

# Optional Cloud Multimodal LLM (Google Gemini via Google AI Studio)
GEMINI_API_KEY=AIzaSyYOUR_GEMINI_API_KEY

# Optional Enterprise Deepfake Forensics APIs
REALITY_DEFENDER_API_KEY=your_reality_defender_api_key
HIVE_API_KEY=your_hive_moderation_api_key

# --- Mobile Push & Threat Sync ---
# Path to Firebase Admin SDK service account credentials
FIREBASE_SERVICE_ACCOUNT_KEY=./secrets/firebase_service_account.json

# --- Core System Security ---
ADONAI_SECRET_KEY=adonai-local-pilot-hmac-key-do-not-expose-publicly

